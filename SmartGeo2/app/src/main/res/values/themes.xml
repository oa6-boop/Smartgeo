<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="Theme.SmartGeo"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sg_primary</item>
        <item name="colorPrimaryVariant">@color/sg_primary_dark</item>
        <item name="colorSecondary">@color/sg_accent</item>
        <item name="colorSurface">@color/sg_surface</item>
        <item name="colorOnSurface">@color/sg_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/sg_primary_dark</item>
        <item name="android:navigationBarColor">@color/sg_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/sg_background</item>
        <item name="materialButtonStyle">@style/SmartGeoButton</item>
    </style>
    <style
        name="SmartGeoButton"
        parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
